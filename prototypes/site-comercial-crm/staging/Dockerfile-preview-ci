# CI-only proof of private preview: never deploy to VPS or a public registry.
# The context is prototypes/site-comercial-crm with a restrictive .dockerignore.
FROM nginx:1.29-alpine
COPY staging/nginx-preview-ci.conf /etc/nginx/nginx.conf
COPY index.html /usr/share/nginx/html/index.html
COPY assets/logo-imagine.png /usr/share/nginx/html/assets/logo-imagine.png
COPY assets/site.css /usr/share/nginx/html/assets/site.css
COPY assets/site.js /usr/share/nginx/html/assets/site.js
COPY fluxo-demo/index.html /usr/share/nginx/html/fluxo-demo/index.html
USER nginx
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
