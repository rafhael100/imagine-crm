# F3-267 review-only web image: build in isolated PR #517 CI; never publish or deploy.
# Copy only public files and the reviewed nginx.conf from the same checkout.
FROM nginx:1.29-alpine@sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de
COPY infra/staging/nginx.conf /etc/nginx/nginx.conf
COPY public/ /var/www/html/public/
USER nginx
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
