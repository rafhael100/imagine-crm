# F0 exclusivamente desenvolvimento local. Sem credenciais reais no GitHub.
APP_NAME="CRM Imagine"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=imagine_crm_f0
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Separate opt-in for disposable PostgreSQL tenant schema migrations only.
CRM_TENANT_SCHEMA_EXPERIMENTAL=false
